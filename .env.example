# Kopiere diese Datei nach .env und trage deine Keys ein. .env wird nie eingecheckt.
# FRED/ALFRED (Pflicht): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Tiingo (Zweitquelle US-Proxies): https://www.tiingo.com/account/api/token
TIINGO_API_KEY=
# Optional, nur mit Abo. Provider zusaetzlich in config/sources.yaml einschalten.
EODHD_API_KEY=
SIPA_API_KEY=
MSCI_API_KEY=
